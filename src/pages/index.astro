---
import Base from "../layouts/Base.astro";
import { ro as c } from "../content/ro";

const year = new Date().getFullYear();
const hasForm = c.contact.formspreeEndpoint !== "";
const mailto = `mailto:${c.contact.email}?subject=${encodeURIComponent(
  c.contact.form.mailtoSubject,
)}`;

// Prefixează căile din `public/` cu base-ul curent (rădăcină sau subcale).
const asset = (path: string) =>
  `${import.meta.env.BASE_URL}/${path}`.replace(/\/{2,}/g, "/");
---

<Base lang={c.lang} title={c.meta.title} description={c.meta.description}>
  <!-- ======================= HEADER ======================= -->
  <header class="border-b border-line">
    <div
      class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-6 py-5"
    >
      <a
        href={import.meta.env.BASE_URL}
        class="flex items-center"
        aria-label={c.brand.name}
      >
        <img
          src={asset(c.brand.logo)}
          alt={c.brand.name}
          width="112"
          height="34"
          class="h-8 w-auto"
        />
      </a>
      <nav aria-label="Principal" class="hidden md:block">
        <ul class="flex items-center gap-8">
          {
            c.nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-sm text-muted transition-colors hover:text-white"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </header>

  <main id="main">
    <!-- ======================= HERO ======================= -->
    <section class="mx-auto max-w-6xl px-6 pt-16 pb-20 md:pt-24 md:pb-28">
      <div class="grid items-start gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-7">
          <p
            class="inline-flex items-center gap-2.5 border border-line px-3 py-1.5 text-xs tracking-[0.18em] text-muted uppercase"
          >
            <span class="h-1.5 w-1.5 rounded-full bg-brand" aria-hidden="true"
            ></span>
            {c.hero.status}
          </p>

          <h1
            class="mt-7 text-4xl sm:text-5xl lg:text-[3.75rem] lg:leading-[1.02]"
          >
            {c.hero.title}
          </h1>

          <p class="mt-7 max-w-2xl text-lg leading-relaxed text-muted">
            {c.hero.intro}
          </p>

          <p
            class="mt-8 max-w-2xl border-l-2 border-brand bg-panel py-4 pr-5 pl-5 text-base leading-relaxed text-white/90"
          >
            {c.hero.differentiator}
          </p>

          <div class="mt-10 flex flex-wrap items-center gap-4">
            <a
              href={c.hero.ctaPrimary.href}
              class="bg-brand px-7 py-3.5 text-sm font-bold tracking-wider text-white uppercase transition-opacity hover:opacity-90"
            >
              {c.hero.ctaPrimary.label}
            </a>
            <a
              href={c.hero.ctaSecondary.href}
              class="border border-line px-7 py-3.5 text-sm font-bold tracking-wider text-white uppercase transition-colors hover:border-white/40"
            >
              {c.hero.ctaSecondary.label}
            </a>
          </div>
        </div>

        <div class="lg:col-span-5">
          {
            c.photoSlots.hero.src ? (
              <img
                src={asset(c.photoSlots.hero.src)}
                alt={c.photoSlots.hero.alt}
                class="w-full object-cover"
                style={`aspect-ratio:${c.photoSlots.hero.ratio}`}
                loading="eager"
              />
            ) : (
              <div
                class="photo-slot"
                style={`aspect-ratio:${c.photoSlots.hero.ratio}`}
              >
                <span class="text-xs font-bold tracking-[0.2em] uppercase">
                  {c.photoSlots.hero.label}
                </span>
                <span class="text-xs">{c.photoSlots.hero.ratio}</span>
              </div>
            )
          }
        </div>
      </div>
    </section>

    <!-- ======================= OFERTA ======================= -->
    <section id="oferta" class="rule scroll-mt-20">
      <div class="mx-auto max-w-6xl px-6 py-20 md:py-28">
        <span class="skew-bar" aria-hidden="true"></span>
        <p class="kicker mt-6">{c.offer.kicker}</p>
        <h2 class="mt-4 max-w-3xl text-3xl sm:text-4xl lg:text-5xl">
          {c.offer.title}
        </h2>

        <div class="mt-14 grid gap-px bg-line md:grid-cols-3">
          {
            c.offer.items.map((item) => (
              <article class="bg-ink p-8 md:p-9">
                <p class="font-display text-sm tracking-widest text-brand">
                  {item.number}
                </p>
                <h3 class="mt-4 text-xl font-bold tracking-wide uppercase">
                  {item.title}
                </h3>
                <p class="mt-4 leading-relaxed text-muted">{item.body}</p>
              </article>
            ))
          }
        </div>

        <p class="mt-10 max-w-3xl text-muted-2">{c.offer.footnote}</p>
      </div>
    </section>

    <!-- ======================= PENTRU CINE ======================= -->
    <section id="pentru-cine" class="rule scroll-mt-20">
      <div class="mx-auto max-w-6xl px-6 py-20 md:py-28">
        <span class="skew-bar" aria-hidden="true"></span>
        <p class="kicker mt-6">{c.audiences.kicker}</p>
        <h2 class="mt-4 max-w-3xl text-3xl sm:text-4xl lg:text-5xl">
          {c.audiences.title}
        </h2>

        <div class="mt-14 grid gap-12 md:grid-cols-2 md:gap-16">
          {
            c.audiences.columns.map((col) => (
              <div>
                <h3 class="font-display text-2xl tracking-wide uppercase">
                  {col.title}
                </h3>
                <p class="mt-2 text-sm text-muted-2">{col.subtitle}</p>
                <ul class="mt-7 space-y-0">
                  {col.points.map((point) => (
                    <li class="flex gap-4 border-t border-line py-5 leading-relaxed text-muted">
                      <span class="text-brand" aria-hidden="true">
                        /
                      </span>
                      <span>{point}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ======================= PROCES ======================= -->
    <section id="proces" class="rule scroll-mt-20">
      <div class="mx-auto max-w-6xl px-6 py-20 md:py-28">
        <span class="skew-bar" aria-hidden="true"></span>
        <p class="kicker mt-6">{c.process.kicker}</p>
        <h2 class="mt-4 max-w-3xl text-3xl sm:text-4xl lg:text-5xl">
          {c.process.title}
        </h2>

        <ol class="mt-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
          {
            c.process.steps.map((step) => (
              <li class="border-t-2 border-brand pt-6">
                <p class="font-display text-3xl text-white/15">{step.number}</p>
                <h3 class="mt-3 text-lg font-bold tracking-wide uppercase">
                  {step.title}
                </h3>
                <p class="mt-3 leading-relaxed text-muted">{step.body}</p>
              </li>
            ))
          }
        </ol>

        <div class="mt-16">
          {
            c.photoSlots.activation.src ? (
              <img
                src={asset(c.photoSlots.activation.src)}
                alt={c.photoSlots.activation.alt}
                class="w-full object-cover"
                style={`aspect-ratio:${c.photoSlots.activation.ratio}`}
                loading="lazy"
              />
            ) : (
              <div class="photo-slot h-56 md:h-72">
                <span class="text-xs font-bold tracking-[0.2em] uppercase">
                  {c.photoSlots.activation.label}
                </span>
                <span class="text-xs">{c.photoSlots.activation.ratio}</span>
              </div>
            )
          }
        </div>
      </div>
    </section>

    <!-- ======================= SEZONUL 2027 ======================= -->
    <section id="sezon" class="rule scroll-mt-20">
      <div class="mx-auto max-w-6xl px-6 py-20 md:py-28">
        <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-5">
            <span class="skew-bar" aria-hidden="true"></span>
            <p class="kicker mt-6">{c.season.kicker}</p>
            <h2 class="mt-4 text-3xl sm:text-4xl">{c.season.title}</h2>
          </div>
          <div class="lg:col-span-7">
            {
              c.season.body.map((paragraph) => (
                <p class="mb-6 text-lg leading-relaxed text-muted last:mb-0">
                  {paragraph}
                </p>
              ))
            }
            <a
              href={c.season.cta.href}
              class="mt-8 inline-block border-b-2 border-brand pb-1 text-sm font-bold tracking-wider text-white uppercase transition-colors hover:text-brand"
            >
              {c.season.cta.label}
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ======================= CONTACT ======================= -->
    <section id="contact" class="rule scroll-mt-20">
      <div class="mx-auto max-w-6xl px-6 py-20 md:py-28">
        <span class="skew-bar" aria-hidden="true"></span>
        <p class="kicker mt-6">{c.contact.kicker}</p>
        <h2 class="mt-4 text-3xl sm:text-4xl lg:text-5xl">
          {c.contact.title}
        </h2>

        <div class="mt-14 grid gap-12 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-5">
            <p class="text-lg leading-relaxed text-muted">
              {c.contact.intro}
            </p>

            <dl class="mt-10 space-y-6">
              <div>
                <dt class="text-xs tracking-[0.2em] text-muted-2 uppercase">
                  Persoană de contact
                </dt>
                <dd class="mt-1.5 text-lg">
                  {c.contact.person}
                  <span class="text-muted-2">, {c.contact.role}</span>
                </dd>
              </div>
              <div>
                <dt class="text-xs tracking-[0.2em] text-muted-2 uppercase">
                  E-mail
                </dt>
                <dd class="mt-1.5 text-lg">
                  <a
                    href={`mailto:${c.contact.email}`}
                    class="underline decoration-brand underline-offset-4 transition-colors hover:text-brand"
                    >{c.contact.email}</a
                  >
                </dd>
              </div>
              <div>
                <dt class="text-xs tracking-[0.2em] text-muted-2 uppercase">
                  Telefon
                </dt>
                <dd class="mt-1.5 text-lg">
                  <a
                    href={`tel:${c.contact.phoneHref}`}
                    class="underline decoration-brand underline-offset-4 transition-colors hover:text-brand"
                    >{c.contact.phone}</a
                  >
                </dd>
              </div>
              <div>
                <dt class="text-xs tracking-[0.2em] text-muted-2 uppercase">
                  Locație
                </dt>
                <dd class="mt-1.5 text-lg">{c.contact.city}</dd>
              </div>
            </dl>
          </div>

          <div class="lg:col-span-7">
            {
              hasForm ? (
                <form
                  action={c.contact.formspreeEndpoint}
                  method="POST"
                  class="grid gap-5 sm:grid-cols-2"
                >
                  <div class="sm:col-span-1">
                    <label
                      for="name"
                      class="block text-xs tracking-[0.2em] text-muted-2 uppercase"
                    >
                      {c.contact.form.name}
                    </label>
                    <input
                      id="name"
                      name="name"
                      type="text"
                      required
                      autocomplete="name"
                      class="mt-2 w-full border border-line bg-panel px-4 py-3 text-white outline-none focus:border-brand"
                    />
                  </div>
                  <div class="sm:col-span-1">
                    <label
                      for="company"
                      class="block text-xs tracking-[0.2em] text-muted-2 uppercase"
                    >
                      {c.contact.form.company}
                    </label>
                    <input
                      id="company"
                      name="company"
                      type="text"
                      autocomplete="organization"
                      class="mt-2 w-full border border-line bg-panel px-4 py-3 text-white outline-none focus:border-brand"
                    />
                  </div>
                  <div class="sm:col-span-2">
                    <label
                      for="email"
                      class="block text-xs tracking-[0.2em] text-muted-2 uppercase"
                    >
                      {c.contact.form.email}
                    </label>
                    <input
                      id="email"
                      name="email"
                      type="email"
                      required
                      autocomplete="email"
                      class="mt-2 w-full border border-line bg-panel px-4 py-3 text-white outline-none focus:border-brand"
                    />
                  </div>
                  <div class="sm:col-span-2">
                    <label
                      for="message"
                      class="block text-xs tracking-[0.2em] text-muted-2 uppercase"
                    >
                      {c.contact.form.message}
                    </label>
                    <textarea
                      id="message"
                      name="message"
                      rows="5"
                      required
                      placeholder={c.contact.form.messagePlaceholder}
                      class="mt-2 w-full border border-line bg-panel px-4 py-3 text-white outline-none placeholder:text-muted-2 focus:border-brand"
                    />
                  </div>
                  <div class="sm:col-span-2">
                    <button
                      type="submit"
                      class="bg-brand px-7 py-3.5 text-sm font-bold tracking-wider text-white uppercase transition-opacity hover:opacity-90"
                    >
                      {c.contact.form.submit}
                    </button>
                    <p class="mt-4 text-sm text-muted-2">
                      {c.contact.form.note}
                    </p>
                  </div>
                </form>
              ) : (
                <div class="border border-line bg-panel p-8 md:p-10">
                  <p class="text-lg leading-relaxed text-muted">
                    Scrie-ne direct pe e-mail. Răspundem în aceeași zi
                    lucrătoare.
                  </p>
                  <a
                    href={mailto}
                    class="mt-7 inline-block bg-brand px-7 py-3.5 text-sm font-bold tracking-wider text-white uppercase transition-opacity hover:opacity-90"
                  >
                    Scrie un e-mail
                  </a>
                  <p class="mt-6 text-sm text-muted-2">
                    Formularul cu inbox propriu se activează completând
                    <code class="text-muted">formspreeEndpoint</code> în
                    <code class="text-muted">src/content/ro.ts</code>.
                  </p>
                </div>
              )
            }
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- ======================= FOOTER ======================= -->
  <footer class="rule">
    <div
      class="mx-auto flex max-w-6xl flex-col gap-4 px-6 py-10 text-sm text-muted-2 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>&copy; {year} {c.brand.name}. {c.footer.rights}</p>
      <p class="max-w-md sm:text-right">{c.footer.legal}</p>
    </div>
  </footer>
</Base>
